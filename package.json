{
  "name": "glance-qm",
  "version": "0.1.0",
  "private": true,
  "description": "kompX — ambient Meta glasses interface for QM and GBrain.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0 --port 5174",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
