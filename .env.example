# Copy to ignored local state before connecting providers. Never commit values.
HOST=127.0.0.1
PORT=8790
WEB_PORT=5174
GLANCE_LOCAL_DIR=.local
GLANCE_OPERATOR_TOKEN=
GLANCE_ALLOWED_ORIGINS=

# QM is the primary execution and multiplayer runtime. QM_SOURCE_SECRET is
# preferred; QM_SIGNING_SECRET and CORE_SIGNING_SECRET are accepted aliases.
QM_BASE_URL=
QM_SOURCE_SECRET=
QM_PROJECT_ID=
QM_THREAD_REF=
QM_ACTOR_EXTERNAL_ID=
QM_MODEL=
QM_HARNESS=codex
QM_THINKING_LEVEL=
QM_JUDGE_MODEL=gpt-6-luna
QM_JUDGE_THINKING_LEVEL=low
QM_JUDGE_FAST_MODE=true
QM_CONNECTION_FILE=
QM_RUNTIME_ENV=

# Self-hosted GBrain uses its owner-only OAuth config file. The keyword search
# default is deliberate while embedding quota is unavailable.
GBRAIN_CONFIG_FILE=
GBRAIN_RECALL_TOOL=search
GBRAIN_SAVE_SUMMARY_TOOL=put_page
GBRAIN_GET_PAGE_TOOL=get_page

# Optional workflow memory. Memorable setup and consent remain explicit.
MEMORABLE_BIN=
MEMORABLE_HOME=
MEMORABLE_API_KEY=

# Google Calendar is read/preview verified; sending an invitation remains an
# explicit, separately rehearsed action.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional Jev-native decision gate. QM remains the default decision maker.
GLANCE_DECISION_MODE=qm
JEV_API_KEY=
JEV_MODEL=
